VITE_API_BASE_URL= # Empty
VITE_PROXY_BASE_URL=
VITE_MERCURE_HUB_URL=
VITE_TELEGRAM_BOT_NAME=
# Public website origin — used ONLY by the packaged mobile app, to open OAuth flows
# (Google/Facebook/Instagram/Telegram) in an in-app browser pointed at the real site
# instead of the app's own bundle. Defaults to https://ustoyob.tj if left empty —
# see src/utils/mobileOAuth.ts.
VITE_APP_ORIGIN=

# Pagination: items per page on mobile (<768px) and desktop
VITE_PAGE_SIZE_MOBILE=10
VITE_PAGE_SIZE_DESKTOP=10

# Push-уведомления в браузере (Firebase Cloud Messaging) — конфиг веб-приложения Firebase и ключ VAPID
# (README → «Push-уведомления в браузере»). Пусто — уведомлений нет, плашка «Включите уведомления» не показывается.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
